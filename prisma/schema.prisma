generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Story {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  chapter   Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("story")
}
